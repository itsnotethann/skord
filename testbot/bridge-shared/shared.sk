# One command declared by several servers: a and b declare /who identically, c differently. Bot-side marks are
# the replies each routing branch produced; the servers' own marks are in server-shared/*/.
# The bot's route-order is just "b".

slash command botonly:
	description: Declared by a script on the bot
	trigger:
		reply with "bot botonly"

on ready:
	start server process "a" allowing "call" using scripts "a"
	start server process "b" using scripts "b"
	start server process "c" using scripts "c"

	# The user's linked player is online on a: a answers although b is first in the order.
	server process "a" reports player "Ada" joining
	wait 500 milliseconds
	fire slash command "who" as user "555"
	wait 300 milliseconds

	server process "a" reports player "Cleo" joining
	wait 300 milliseconds
	fire slash command "who" as user "888"
	wait 300 milliseconds

	# Nobody linked: the route order puts b first although a declared the command first.
	fire slash command "who" as user "777"
	wait 300 milliseconds

	# b is gone and the order names only b: the first online owner answers.
	kill server process "b"
	fire slash command "who" as user "777"
	wait 300 milliseconds

	# Both gone: a reply that says so.
	kill server process "a"
	fire slash command "who" as user "777"
	wait 300 milliseconds

	# The bot restarts with both away: the commands stay and Discord is sent nothing.
	set {_before} to the command requests
	simulate a bot restart
	wait 600 milliseconds
	set {_after} to the command requests
	if {_after} is {_before}:
		mark "no command requests after the restart"
	else:
		mark "command requests went from %{_before}% to %{_after}%"

	# The saved commands still route: a comes back and answers.
	start server process "a" allowing "call" using scripts "a"
	fire slash command "who" as user "777"
	wait 300 milliseconds
