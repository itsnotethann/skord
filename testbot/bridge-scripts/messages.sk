
shared function joined(player: text):
	mark "join: %{_player}%"

shared function stats(name: text, kills: number):
	mark "stats: %{_name}% has %{_kills}% kills"

shared function squad(names: texts, size: number):
	mark "squad: %{_names::*}% of %{_size}% (%size of {_names::*}%)"

shared function onlinePlayers() :: texts:
	return "Ada" and "Grace"

shared function level(name: text) :: number:
	return 7

on ready:
	connect fake server "lobby" allowing "call"

	fake server "lobby" sends call "joined" with "[""Ada""]"
	wait 150 milliseconds
	fake server "lobby" sends call "stats" with "[""Ada"",3]"
	wait 150 milliseconds
	fake server "lobby" sends call "squad" with "[[""Ada"",""Grace"",""Linus""],3]"
	wait 150 milliseconds

	fake server "lobby" records function "resetSeason"
	resetSeason("now") from "lobby" without waiting
	wait 150 milliseconds

	fake server "lobby" offers function "players" answering "[""Ada"",""Grace"",""Linus""]"
	fake server "lobby" offers function "tps" answering "19.5"
	fake server "lobby" offers function "broken" answering "!fail"
	fake server "lobby" offers function "silent" answering "!hang"
	players() from "lobby" and store it in {_players::*}
	mark "players: %{_players::*}% (%size of {_players::*}%)"
	tps() from "lobby" and store it in {_tps}
	mark "tps: %{_tps}%"
	broken() from "lobby" and store it in {_x}
	mark "broken: %error type of last request error%, %last request error%"
	nobodyKnows() from "lobby" and store it in {_x}
	mark "unknown: %error type of last request error%"
	silent() from "lobby" and store it in {_x}
	mark "silent: %error type of last request error%"
	set {_alias} to last discord error
	mark "alias: %error type of {_alias}%"

	fake server "lobby" calls "onlinePlayers" on the bot and store it in {_a::*}
	mark "bot says: %{_a::*}%"
	fake server "lobby" calls "level" on the bot with "[""Ada""]" and store it in {_b}
	mark "level: %{_b}%"
	fake server "lobby" calls "noSuchThing" on the bot and store it in {_c}
	mark "no function: %error type of last request error%"

	disconnect fake server "lobby"
	players() from "lobby" and store it in {_x}
	mark "ask offline: %error type of last request error%"
	resetSeason("now") from "lobby" without waiting
	mark "send offline: no pause"
