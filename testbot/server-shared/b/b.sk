slash command who:
	description: Says which server answered
	trigger:
		reply with "who from b"

shared function linksPage(after: text) :: texts:
	if {_after} is "":
		return "555" and "1a382809-b7c0-3f68-ae12-dd15677c5497"
	if {_after} is "555":
		return "999" and "6e1def9b-fa26-3279-b0ba-900d46f8c9b3"
